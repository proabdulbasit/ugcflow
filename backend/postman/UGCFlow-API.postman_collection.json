    {
      "name": "Campaigns (Admin)",
      "description": "Admin campaign management and creator assignment.",
      "item": [
        {
          "name": "List All Campaigns",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
