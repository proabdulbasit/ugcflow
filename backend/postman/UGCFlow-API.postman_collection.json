              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const pkgs = pm.response.json().packages;",
                  "  if (pkgs && pkgs.length) pm.collectionVariables.set('packageId', pkgs[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/packages",
            "description": "List pricing packages sorted by price."
          }
        },
        {
          "name": "Get Package by ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/packages/{{packageId}}",
            "description": "Get single package."
          }
        }
      ]
    },
