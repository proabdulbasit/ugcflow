{
  "info": {
    "_postman_id": "ugcflow-api-collection",
    "name": "UGCFlow API",
    "description": "Complete UGCFlow backend API (Express + MongoDB + JWT).\n\n**Base URL:** `{{baseUrl}}` (default: http://localhost:4000)\n\n**Typical flow:**\n1. **Register** brand/creator → returns `applicationStatus: pending` (no token)\n2. **Admin** approves via status endpoints\n3. **Login** → JWT saved to `{{token}}`\n4. Use role-specific routes\n\n**Auth:** `Authorization: Bearer {{token}}` or cookie `token`\n\n**Roles:** `admin` | `brand` | `creator`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "adminSeedSecret", "value": "ugcflow-admin-seed-2026" },
    { "key": "jwtSecret", "value": "ugcflow-jwt-secret-change-in-production-2026" },
    { "key": "userId", "value": "" },
    { "key": "brandId", "value": "" },
    { "key": "creatorId", "value": "" },
    { "key": "campaignId", "value": "" },
    { "key": "deliverableId", "value": "" },
    { "key": "packageId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Public health check.\n\n- `{ ok: true }` when MongoDB is connected\n- `503 { ok: false, db: 'connecting' }` while DB is starting"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Registration does **not** return a JWT. Users must be admin-approved, then log in.",
      "item": [
        {
          "name": "Register Brand",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('userId', json.user.id);",
                  "  pm.collectionVariables.set('brandId', json.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"brand@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Jane Brand\",\n  \"role\": \"brand\",\n  \"companyName\": \"Acme Co\",\n  \"websiteUrl\": \"https://acme.com\",\n  \"brandGoals\": \"Scale UGC ads\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Submit brand application. Sets `status: pending`. **No token returned.**\n\n**Required:** email, password (min 8), role=`brand`\n\n**Optional:** fullName, companyName, websiteUrl, brandGoals"
          }
        },
        {
          "name": "Register Creator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('userId', json.user.id);",
                  "  pm.collectionVariables.set('creatorId', json.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"creator@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"John Creator\",\n  \"role\": \"creator\",\n  \"portfolioUrl\": \"https://tiktok.com/@creator\",\n  \"bio\": \"UGC specialist\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Submit creator application. Sets `status: pending`. **No token returned.**\n\n**Required:** email, password (min 8), role=`creator`\n\n**Optional:** fullName, portfolioUrl, bio"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  pm.collectionVariables.set('userId', json.user.id);",
                  "  if (json.user.role === 'brand') pm.collectionVariables.set('brandId', json.user.id);",
                  "  if (json.user.role === 'creator') pm.collectionVariables.set('creatorId', json.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"brand@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Login with email/password.\n\nReturns `{ user, token }` when approved.\n\n**403** if application is `pending` or `rejected`."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Current user + role profile.\n\nReturns `{ user, roleData }`."
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Clears auth cookie. Returns `{ ok: true }`."
          }
        },
        {
          "name": "Setup Admin (Create Account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('userId', json.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-seed-secret", "value": "{{adminSeedSecret}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Admin\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/setup-admin",
            "description": "Create admin account (or reset password / promote existing email).\n\n**Header:** `x-admin-seed-secret` = `ADMIN_SEED_SECRET`"
          }
        },
        {
          "name": "Promote to Admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-admin-seed-secret", "value": "{{adminSeedSecret}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"brand@example.com\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/promote-admin",
            "description": "Promote existing user to admin.\n\n**Header:** `x-admin-seed-secret` = `ADMIN_SEED_SECRET`"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"companyName\": \"New Company\",\n  \"websiteUrl\": \"https://newsite.com\",\n  \"portfolioUrl\": \"https://portfolio.com\",\n  \"bio\": \"Updated bio\"\n}"
            },
            "url": "{{baseUrl}}/api/users/profile",
            "description": "Update profile by role.\n\n**Brand:** fullName, companyName, websiteUrl\n**Creator:** fullName, portfolioUrl, bio"
          }
        },
        {
          "name": "List All Profiles (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/profiles",
            "description": "List users for admin messaging.\n\n**Auth:** Admin only"
          }
        }
      ]
    },
    {
      "name": "Packages",
      "description": "Public pricing packages.",
      "item": [
        {
          "name": "List Packages",
          "event": [
