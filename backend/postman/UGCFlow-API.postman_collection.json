    {
      "name": "Deliverables",
      "item": [
        {
          "name": "Submit Deliverable (Creator)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const d = pm.response.json().deliverable;",
                  "  if (d && d.id) pm.collectionVariables.set('deliverableId', d.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaignId\": \"{{campaignId}}\",\n  \"fileUrl\": \"https://drive.google.com/file/d/example/view\"\n}"
            },
            "url": "{{baseUrl}}/api/deliverables",
            "description": "Submit or resubmit deliverable for an assigned campaign.\n\n**Required:** campaignId, fileUrl\n\n**Auth:** Creator (must be assigned)\n\n- First submit → `201`\n- Resubmit after rejection → `200` (increments revisionCount)\n- Pending/approved submissions return `400`"
          }
        },
        {
          "name": "Review Deliverable (Brand/Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"feedback\": \"Great work!\"\n}"
            },
            "url": "{{baseUrl}}/api/deliverables/{{deliverableId}}/review",
            "description": "Approve or reject deliverable.\n\n**status:** `approved` | `rejected`\n\nOn approve, creator earnings record is created."
          }
        },
        {
          "name": "List Submissions (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/deliverables/admin?status=all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "deliverables", "admin"],
              "query": [
                { "key": "status", "value": "all", "description": "all | pending | approved | rejected" }
              ]
            },
            "description": "List deliverables/submissions.\n\n**Query:** `status` filter"
          }
        }
      ]
