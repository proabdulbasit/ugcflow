          }
        },
        {
          "name": "Admin Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/analytics",
            "description": "Aggregate counts: pending creators/brands, campaigns, deliverables, revenue."
          }
        }
      ]
    }
  ]
}
