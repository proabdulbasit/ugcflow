        },
        {
          "name": "Brand Billing",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/brands/billing",
            "description": "Credits balance + payment history."
          }
        },
        {
          "name": "List My Campaigns",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const camps = pm.response.json().campaigns;",
                  "  if (camps && camps.length) pm.collectionVariables.set('campaignId', camps[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/brands/campaigns",
            "description": "List brand campaigns with application/deliverable counts."
          }
        },
        {
          "name": "Create Campaign",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const c = pm.response.json().campaign;",
                  "  if (c && c._id) pm.collectionVariables.set('campaignId', c._id);",
                  "  if (c && c.id) pm.collectionVariables.set('campaignId', c.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Summer Skincare UGC\",\n  \"brief\": \"Looking for 30s TikTok-style review videos showcasing our vitamin C serum.\",\n  \"referenceVideoUrl\": \"https://www.tiktok.com/@example/video/123\",\n  \"productUrl\": \"https://acme.com/products/vitamin-c-serum\",\n  \"targetPlatform\": \"TikTok\",\n  \"videoFormat\": \"Vertical 9:16, 30-45 seconds\",\n  \"talkingPoints\": \"Mention hydration, morning routine, before/after glow\",\n  \"dosAndDonts\": \"Do show product texture. Don't mention competitor brands.\"\n}"
            },
            "url": "{{baseUrl}}/api/brands/campaigns",
            "description": "Create campaign. Costs **89 credits** (refunded if create fails).\n\n**Required:** title, brief\n\n**Optional:** referenceVideoUrl, productUrl, targetPlatform, videoFormat, talkingPoints, dosAndDonts"
          }
        },
        {
          "name": "Get Campaign Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/brands/campaigns/{{campaignId}}",
            "description": "Campaign detail with deliverables and creator applications."
          }
        }
      ]
    },
