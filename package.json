{
  "name": "nextjs-base-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DISABLE_ESLINT=1 NEXT_DISABLE_TYPECHECK=1 next dev --turbopack",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "npm run dev --prefix backend & npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "type-check": "tsc --noEmit",
    "check-all": "npm run lint & npm run type-check & wait"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.563.0",
    "next": "15.5.7",
    "posthog-js": "^1.270.1",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.9.1",
    "sonner": "^2.0.7",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.12.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
